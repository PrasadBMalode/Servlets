<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>
<div>
    <form action="instagram" method="post">
        <label for="name">User name</label>
        <input type="text"  id="name" placeholder="User name" name="name" ><br><br>

        <label for="email">User Email</label>
        <input type="email"  id="email" placeholder="Email" name="email" ><br><br>

        <label for="password">User Password</label>
        <input type="password"  id="password" placeholder="your password" name="password" ><br><br>

        <button type="submit">SignUp</button>
    </form>
</div>
</body>
</html>